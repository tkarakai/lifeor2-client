# Public URL of this Next.js app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web app URL (for cross-app links to sign-up, dashboard)
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3002

# Convex HTTP endpoint URL (for client-side waitlist + announcement API calls)
# Auto-injected by dev-start.sh in development
NEXT_PUBLIC_CONVEX_SITE_URL=http://localhost:3211

# Environment banner (development | staging | production)
# Leave empty in production. Auto-detected as "development" when NODE_ENV=development.
# NEXT_PUBLIC_APP_ENVIRONMENT=
# NEXT_PUBLIC_GIT_SHA=
# NEXT_PUBLIC_DEPLOY_TIMESTAMP=
# NEXT_PUBLIC_APP_NAME=landing
# NEXT_PUBLIC_BUILD_ID=
