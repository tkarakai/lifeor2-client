# Convex URLs (populated by dev-start.sh or set manually for production)
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Public URL of this Next.js app
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Landing page URL (for cross-app links to terms, privacy, back-to-landing)
NEXT_PUBLIC_LANDING_URL=http://localhost:3000

# Environment banner (development | staging | production)
# Leave empty in production. Auto-detected as "development" when NODE_ENV=development.
# NEXT_PUBLIC_APP_ENVIRONMENT=
# NEXT_PUBLIC_GIT_SHA=
# NEXT_PUBLIC_DEPLOY_TIMESTAMP=
# NEXT_PUBLIC_APP_NAME=web
# NEXT_PUBLIC_BUILD_ID=

# Edge rate limiting (proxy-level, per-IP)
# EDGE_RATE_LIMIT_WINDOW=60
# EDGE_RATE_LIMIT_MAX=200
# EDGE_RATE_LIMIT_MAP_MAX_SIZE=10000

# LifeOR2 connection (operator-owned endpoints; never NEXT_PUBLIC secrets)
LIFEOR_MCP_URL=http://localhost:3000/mcp
# Register in LifeOR2: Workspace → Agent connections → Register client.
LIFEOR_OAUTH_CLIENT_ID=
# Must match the actual client port and registered callback exactly.
LIFEOR_OAUTH_REDIRECT_URI=http://localhost:3002/api/lifeor/oauth/callback

# One configurable OpenAI-compatible Chat Completions model
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=gemma-4-12B-it-8bit
LLM_API_KEY=
LLM_CONTEXT_WINDOW=16384
LLM_MAX_OUTPUT_TOKENS=2048
LLM_MAX_CONCURRENT_RUNS=2
AGENT_MAX_TOOL_ROUNDS=12
AGENT_TIMEOUT_MS=300000

# Generated automatically for loopback development by dev-start.sh.
# In production generate independent secrets; set LIFEOR_STORE_SECRET on both
# Next.js and the CLIENT Convex deployment. The encryption key stays on Next.js.
LIFEOR_STORE_SECRET=
MCP_TOKEN_ENCRYPTION_KEY=
